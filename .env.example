# ─────────────────────────────────────────────────────────────
# LeadScan — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite chaves reais.
# Todas as chaves são lidas SOMENTE no servidor (lib/env.ts).
# Configurações → Plataforma mostra o que está ativo.
# ─────────────────────────────────────────────────────────────

# Banco PostgreSQL.
# Local sem instalar nada:  npm run db:start  (Prisma Dev / Postgres embutido, 1 conexão por vez)
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
# Produção (Vercel + Neon/Supabase): DATABASE_URL = conexão COM pooler (o app).
# Conexão DIRETA (migrações e tempo real) — a integração da Vercel já cria uma destas:
#   DATABASE_URL_UNPOOLED (Neon) · POSTGRES_URL_NON_POOLING (Supabase). Outro provedor: preencha as duas abaixo.
DIRECT_URL=""
REALTIME_DATABASE_URL=""
# Conexões por instância (padrão: 5 na Vercel, 10 em servidor próprio)
DB_POOL_MAX=""

# Segredo da sessão e dos códigos de login (32+ caracteres em produção):  openssl rand -base64 32
AUTH_SECRET=""
# Chave de 32 bytes em base64 que criptografa chaves de IA e tokens de pagamento dos usuários.
# Obrigatória em produção. Gere com:  openssl rand -base64 32   (NÃO troque depois: os dados salvos dependem dela)
ENCRYPTION_KEY=""

# demo   = login mostra "Explorar a demonstração" + pagamentos de teste ligados
# public = só contas reais (Google, e-mail, celular)
AUTH_MODE="demo"
# E-mails que viram administradores ao criar conta (separados por vírgula)
ADMIN_EMAILS=""
# Encarregado de dados (LGPD) — aparece em /privacidade
CONTACT_EMAIL=""

# ── Login ───────────────────────────────────────────────────
# Google: console.cloud.google.com → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web)
#   URI de redirecionamento autorizado: https://SEU_DOMINIO/api/auth/google/callback
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Código por e-mail (resend.com). Sem chave: em dev o código aparece na tela; em produção o login por e-mail fica indisponível.
RESEND_API_KEY=""
EMAIL_FROM="LeadScan <nao-responda@seudominio.com.br>"
# Código por SMS (twilio.com). TWILIO_FROM = número (+55…) ou Messaging Service SID (MG…)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ── Moderação de fotos (bloqueia nudez / conteúdo +18) ──────
# none (só no modo demo) | openai (endpoint de moderação, gratuito) | sightengine
MODERATION_PROVIDER="none"
MODERATION_API_KEY=""
SIGHTENGINE_USER=""
SIGHTENGINE_SECRET=""

# ── Motor de Leads (fontes de dados) ─────────────────────────
# mock   = empresas fictícias determinísticas (padrão, sem custo)
# osm    = OpenStreetMap/Overpass (gratuito, dados reais, sem avaliações)
# google = Google Places API (New) — nota, avaliações, site, telefone e FOTOS reais
DATA_PROVIDER="mock"
# console.cloud.google.com → ative "Places API (New)" → Credenciais → Chave de API (restrinja por IP do servidor)
MAPS_API_KEY=""
OVERPASS_URL="https://overpass-api.de/api/interpreter"
# Reservado para um provedor empresarial (ex.: base CNPJ licenciada)
DATA_PROVIDER_API_KEY=""

# ── IA da plataforma (opcional) ─────────────────────────────
# Cada usuário pode conectar a PRÓPRIA IA em /integracoes (Claude, ChatGPT, Gemini, OpenRouter, Groq…).
# Esta é a IA de reserva para quem não conectou nenhuma.  none | anthropic | openai (qualquer API compatível)
AI_PROVIDER="none"
AI_API_KEY=""
# Vazio = padrão (anthropic: claude-opus-5 com effort "low"). Para custo menor: claude-haiku-4-5
AI_MODEL=""
AI_BASE_URL=""
# true = libera "Ollama (local)" nas integrações (só faz sentido em instalação própria)
AI_ALLOW_LOCAL=""

# ── Pagamentos ──────────────────────────────────────────────
# Pagamentos de teste (simulador de Pix/cartão). Vazio = ligado no modo demo, desligado em public.
PAYMENTS_MOCK=""
# Mercado Pago (marketplace): mercadopago.com.br/developers → Suas integrações → credenciais de produção
#   Redirect URL da aplicação: https://SEU_DOMINIO/api/payments/connect/mercadopago/callback
#   Webhooks: https://SEU_DOMINIO/api/webhooks/mercadopago  (evento "Pagamentos"; copie a assinatura secreta)
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_WEBHOOK_SECRET=""
# Stripe Connect: dashboard.stripe.com → Desenvolvedores. Webhook: https://SEU_DOMINIO/api/webhooks/stripe
#   eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
#            checkout.session.async_payment_failed, checkout.session.expired, charge.refunded, account.updated
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# true = oferece Pix no checkout da Stripe (exige Pix habilitado na sua conta Stripe Brasil)
STRIPE_PIX=""
# Comissão da plataforma sobre cada cobrança paga (0 a 30). 0 = sem comissão.
PLATFORM_FEE_PERCENT="0"
# Valor mínimo (centavos) para uma venda pontuar no ranking e contar para níveis. Padrão R$ 100.
RANKING_MIN_SALE_CENTS="10000"

# ── Tempo real ──────────────────────────────────────────────
# Com várias instâncias, eventos passam por LISTEN/NOTIFY do Postgres. false desliga.
REALTIME_PG=""

# ── WhatsApp ────────────────────────────────────────────────
# Hoje o app usa links wa.me (sem API). Reservado para a API oficial do WhatsApp Business.
WHATSAPP_PROVIDER_API_KEY=""

# URL pública do app (links de proposta, pagamento e retornos OAuth). Obrigatória em produção.
# Vazia em dev: usa o host da requisição.
NEXT_PUBLIC_APP_URL=""
